{
    "custom/mpris-previous": {
        "exec": "printf '󰙣'",
        "exec-if": "playerctl --player spotify status >/dev/null 2>&1",
        "hide-empty-text": true,
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Previous",
        "on-click": "playerctl --player spotify previous"
    },
    "custom/mpris-next": {
        "exec": "printf '󰙡'",
        "exec-if": "playerctl --player spotify status >/dev/null 2>&1",
        "hide-empty-text": true,
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Next",
        "on-click": "playerctl --player spotify next"
    },
    "mpris#main": {
        "player": "spotify",
        "interval": 1,
        "justify": "center",
        "min-length": 8,
        "max-length": 36,
        "title-len": 26,
        "artist-len": 18,
        "album-len": 0,
        "dynamic-len": 32,
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-importance-order": [
            "title",
            "artist"
        ],
        "dynamic-separator": " · ",
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "format-stopped": "{status_icon}",
        "player-icons": {
            "default": "",
            "chromium": "",
            "firefox": "󰈹",
            "mpv": "󰐹",
            "spotify": "",
            "spotifyd": "",
            "vlc": "󰕼"
        },
        "status-icons": {
            "paused": "",
            "playing": "",
            "stopped": ""
        },
        "tooltip": true,
        "tooltip-format": "{player}\n{title}\n{artist}\n{position}/{length}\n\nButtons: previous / next\nScroll: seek",
        "tooltip-format-paused": "{player} (paused)\n{title}\n{artist}\n{position}/{length}\n\nButtons: previous / next\nScroll: seek",
        "tooltip-format-stopped": "{player} (stopped)",
        "on-scroll-up": "playerctl position 5+",
        "on-scroll-down": "playerctl position 5-"
    }
}
